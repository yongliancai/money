{
  "name": "ai-bookkeeping-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23 <23"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:pages": "vite --mode pages --host 127.0.0.1",
    "dev:server": "node --env-file-if-exists=.env.local --watch server/src/index.js",
    "start": "node --env-file-if-exists=.env.local server/src/index.js",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "preview:pages": "vite preview --mode pages --host 127.0.0.1 --port 4173",
    "test:pages": "node scripts/test-pages.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "guardrails": "node scripts/guardrails.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "verify:record": "node scripts/record-verification.mjs",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js tests/contracts/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:contracts": "node --test tests/contracts/*.test.js",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run format:check && npm run guardrails && npm run docs:check && npm test && npm run build && npm run test:e2e && npm run test:pages"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "idb": "^8.0.3",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "eslint": "^10.15.0",
    "espree": "^11.2.0",
    "fake-indexeddb": "^6.2.4",
    "fast-check": "^4.5.3",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "vite": "^8.3.8",
    "yaml": "^2.9.1"
  }
}
