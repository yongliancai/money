# Local isolated environment. Copy to ignored .env.local only if needed.
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
DB_PATH=data/reminders.sqlite
# Disabled until model/provider/budget decision and credential approval.
AI_MODE=disabled
# Demonstration parser: set AI_MODE=demo; never a real model evaluation.
# Push defaults to disabled. Generate local VAPID keys only after choosing a test setup.
PUSH_MODE=disabled
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Empty means policy unresolved: formal reminders are suppressed.
REMINDER_MAX_AGE_SECONDS=
REMINDER_DEBOUNCE_SECONDS=
# PUBLIC frontend settings only. Never put API keys into any VITE_ variable.
# Pages builds disable backend unless an explicit HTTPS backend URL is supplied.
VITE_API_BASE_URL=
# Empty: derive Pages base from GITHUB_REPOSITORY or config/site.json.
PAGES_BASE_PATH=
